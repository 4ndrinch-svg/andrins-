        }
      },
      "on_false": {
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield",
          "model": {
            "type": "minecraft:shield"
          },
          "transformation": {
            "translation": [
              0,
              0,
              0
            ],
            "left_rotation": [
              0,
              0,
              0,
              1
            ],
            "right_rotation": [
              0,
              0,
              0,
              1
            ],
            "scale": [
              1,
              -1,
              -1
            ]
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield_blocking",
          "model": {
            "type": "minecraft:shield"
          },
          "transformation": {
            "translation": [
              0,
              0,
              0
            ],
            "left_rotation": [
              0,
