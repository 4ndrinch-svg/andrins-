{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "fixed",
          "ground",
          "gui"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "item/shield_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:has_component",
      "component": "minecraft:enchantments",
      "ignore_default": true,
      "on_true": {
        "property": "minecraft:using_item",
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/respackopts/shield/side_shield"
            },
            {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "minecraft:item/shield",
              "transformation": {
                "translation": [
                  0,
                  0,
                  0
                ],
                "left_rotation": [
                  0,
                  0,
                  0,
                  1
                ],
                "right_rotation": [
                  0,
                  0,
                  0,
                  1
                ],
                "scale": [
                  1,
                  -1,
                  -1
                ]
              }
            }
          ]
        },
        "on_true": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/shield/enchanted_shield_blocking"
            },
            {
              "type": "minecraft:special",
              "model": {
                "type": "minecraft:shield"
              },
              "base": "minecraft:item/shield_blocking",
              "transformation": {
                "translation": [
                  0,
                  0,
                  0
                ],
                "left_rotation": [
                  0,
                  0,
                  0,
                  1
                ],
                "right_rotation": [
                  0,
                  0,
                  0,
                  1
                ],
                "scale": [
                  1,
                  -1,
                  -1
                ]
              }
            }
          ]
        }
      },
      "on_false": {
        "type": "minecraft:condition",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/shield_blocking",
          "model": {
            "type": "minecraft:shield"
          }
        },
        "property": "minecraft:using_item"
      }
    }
  }
}