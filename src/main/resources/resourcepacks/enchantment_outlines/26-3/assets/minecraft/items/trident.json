{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": "gui",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:model",
              "model": "item/firstperson/enchanted_trident_throwing"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "item/firstperson/enchanted_trident_in_hand"
            }
          }
        },
        {
          "when": [
            "thirdperson_lefthand",
            "thirdperson_righthand"
          ],
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:model",
              "model": "item/thirdperson/enchanted_trident_throwing"
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "item/thirdperson/enchanted_trident_in_hand"
            }
          }
        },
        {
          "when": [
            "on_shelf",
            "fixed",
            "ground"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "item/trident_dropped"
          }
        }
      ]
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "on_shelf",
            "fixed",
            "ground",
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:special",
          "model": {
            "type": "minecraft:trident"
          },
          "base": "minecraft:item/trident_throwing",
          "transformation": {
            "translation": [
              0,
              0,
              0
            ],
            "left_rotation": [
              0,
              0,
              0,
              1
            ],
            "right_rotation": [
              0,
              0,
              0,
              1
            ],
            "scale": [
              1,
              -1,
              -1
            ]
          }
        },
        "on_false": {
          "type": "minecraft:special",
          "model": {
            "type": "minecraft:trident"
          },
          "base": "minecraft:item/trident_in_hand",
          "transformation": {
            "translation": [
              0,
              0,
              0
            ],
            "left_rotation": [
              0,
              0,
              0,
              1
            ],
            "right_rotation": [
              0,
              0,
              0,
              1
            ],
            "scale": [
              1,
              -1,
              -1
            ]
          }
        }
      }
    }
  }
}